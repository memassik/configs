configuration
{
    terminal: "/usr/bin/alacritty";
    padding: 20;
    line-padding: 2;
    show-icons: true;
    color-enabled: true;
    hide-scrollbar: true;
    icon-theme: "Papirus Dark";
    font: "IosevkaTerm NF 13";
}
@theme "/usr/share/rofi/themes/dmenu.rasi"

* {
    background-color:      #282828;
    border-color:          #3c3836;
    text-color:            #ebdbb2;
    font:                  "IosevkaTerm NFM 13";
}
element selected {
    background-color:      #d65d0e;
}
